	id = {Barman2019},
	isbn = {2190-5444},
	journal = {The European Physical Journal Plus},
	number = {4},
	pages = {150},
	title = {Current status of MSSM Higgs sector with LHC 13 TeV data},
	url = {https://doi.org/10.1140/epjp/i2019-12566-5},
	volume = {134},
	year = {2019},
	bdsk-url-1 = {https://doi.org/10.1140/epjp/i2019-12566-5}}


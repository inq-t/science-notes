@article{barndorff-nielsen2002estimating,
	abstract = {This paper looks at some recent work on estimating quadratic variation using realized variance (RV)-that is, sums of M squared returns. This econometrics has been motivated by the advent of the common availability of high-frequency financial return data. When the underlying process is a semimartingale we recall the fundamental result that RV is a consistent (as M → ∞) estimator of quadratic variation (QV). We express concern that without additional assumptions it seems difficult to give any measure of uncertainty of the RV in this context. The position dramatically changes when we work with a rather general SV model-which is a special case of the semimartingale model. Then QV is integrated variance and we can derive the asymptotic distribution of the RV and its rate of convergence. These results do not require us to specify a model for either the drift or volatility functions, although we have to impose some weak regularity assumptions. We illustrate the use of the limit theory on some exchange rate data and some stock data. We show that even with large values of M the RV is sometimes a quite noisy estimator of integrated variance.},
	author = {Ole E. Barndorff-Nielsen and Neil Shephard},
	date-added = {2023-12-06 13:14:24 +0000},
	date-modified = {2024-07-03 16:51:17 +0100},
	issn = {08837252, 10991255},
	journal = {Journal of Applied Econometrics},
	number = {5},
	pages = {457--477},
	publisher = {Wiley},
	title = {Estimating Quadratic Variation Using Realized Variance},
	url = {http://www.jstor.org/stable/4129267},
	urldate = {2023-12-06},
	volume = {17},
	year = {2002},

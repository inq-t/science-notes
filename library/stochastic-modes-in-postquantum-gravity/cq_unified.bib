@misc{unknownxxxxl,
  note = {This follows from results
		in entanglement theory\cite{preskill1998lecture,nielsen2010quantum} that entanglement between two separated systems cannot be created through the exchange of fully decohered systems\cite{werner1989quantum} (sometimes called Local Operations and Classical Communication). In this case, the gravitational degrees of freedom are the fully decohered system, as can be seen by writing the state in the  form of Equation \eqref{eq:cq-state}.\label{ft:noentanglement}
There is an assumption that the transfer of pre-existing entanglement from the vacuum to the separated systems is small. Another assumption is that the interactions don't violate cluster separation, which some realisations of classical-quantum dynamics could do,  but we would anticipate this to be a small effect, comparable to the transfer of vacuum entanglement.
}
}


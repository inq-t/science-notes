@misc{unknownxxxxv,
	note = {More rigorously, for any Cauchy surface we define observables in terms of a smearing function $F(x,t)$ and $\phi[F]:=\int dxdt\phi(x,t)F(x,t)$ over a small interval in time. We then have the covariant commutation relations $[\phi[F],\phi[G]]=\Delta(F,G)$ where $\Delta$ is the Pauli-Jordan function. This can be used to define the algebra of observables for operators $(\Box +m^2)\phi=0$, $\phi[(\Box+m^2)F]=0$. Then we use the GNS theorem to relate the algebraic states to the Hilbert space. See for example \cite{brunetti2003generally,fewster2012dynamical,fredenhagen2014construction,fredenhagen2016quantum}. In general, care must be taken in defining the algebra of observables for quantum fields in evolving space times, or in the case of some time dependent Hamiltonians\cite{ashtekar1975quantum,asorey1982quantum,torre1999functional,agullo2015unitarity}.}
}

